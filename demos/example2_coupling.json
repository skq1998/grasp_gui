{
 "format": "grasp-gui-config",
 "version": 2,
 "package": "GRASP2018",
 "id": "example2_coupling",
 "order": 19,
 "title": {
  "zh": "例 2 的 Coupling：B II 的 LK3 / JK3 标记",
  "en": "Example 2 Coupling: B II LK3 / JK3 labels"
 },
 "summary": {
  "zh": "先计算 example2，再由 jj2lsj 写出 Coupling 文件，重耦合并用 LK3 标记列出能级；同时保留 JK3 等方案的文件。需另装 https://github.com/compas/coupling。",
  "en": "Calculate example2, export jj2lsj data for Coupling, recouple and display levels with LK3 labels; JK3 and other schemes remain available. Requires separate installation of https://github.com/compas/coupling."
 },
 "runtime": {
  "zh": "几秒钟",
  "en": "a few seconds"
 },
 "jobs": [
  {
