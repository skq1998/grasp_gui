  },
  {
   "step": "custom",
   "vals": {
    "prog": "rwfnmchfmcdf",
    "args": "",
    "stdin": "",
    "log": ""
   }
  },
  {
   "step": "custom",
   "vals": {
    "prog": "cp",
    "args": "rwfn.out rwfn.inp",
    "stdin": "",
    "log": ""
   }
  },
  {
   "step": "rmcdhf",
   "vals": {
    "mem": false,
