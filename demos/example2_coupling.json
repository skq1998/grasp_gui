    "z": "5",
    "a": "11",
    "revise": false,
    "rms": "",
    "skin": "2.3",
    "mass": "10.81",
    "spin": "1.5",
    "mu": "2.6886489",
    "q": "1"
   }
  },
  {
   "step": "rcsfgenerate",
   "vals": {
    "order": "*",
    "core": "0",
    "lists": [
     {
      "configs": "1s(2,i)2s(1,i)2p(1,i)",
      "active": "2s,2p",
      "jmin": "0",
      "jmax": "4",
      "nexc": "0"
     }
    ],
    "saveas": "2s2p_DF.c"
   }
  },
  {
